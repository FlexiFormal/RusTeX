 \setcounter{subsection}{0}
 \def\thesection{Appendix \Alph{section}}
 \def\thesubsection{\Alph{section}.\arabic{subsection}}
 \def\thesubsubsection{\thesubsection.\arabic{subsubsection}}
 }


