\newcommand{\judgmentsymbol}{\vartriangleright} %the symbol to distinguish judgments
\newcommand{\library}[1]{\judgmentsymbol #1} %valid library
\newcommand{\gsta}[2]{{#1}\judgmentsymbol #2} %valid document declaration
